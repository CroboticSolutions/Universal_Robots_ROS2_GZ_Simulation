<?xml version="1.0"?>
<sdf version="1.6">
  <model name='Coke'>
    <static>false</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh><uri>model://Coke/meshes/coke.obj</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh><uri>model://Coke/meshes/coke.obj</uri></mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            <bullet><friction>0.9</friction><friction2>0.9</friction2></bullet>
          </friction>
          <contact>
            <ode><kp>1e8</kp><kd>1</kd></ode>
            <bullet><kp>1e8</kp><kd>1</kd></bullet>
          </contact>
        </surface>
      </collision>
      <!-- Mass ~0.35 kg for a full can; inertia for cylinder r~0.03m h~0.12m -->
      <inertial>
        <mass>0.35</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0</iyz>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
