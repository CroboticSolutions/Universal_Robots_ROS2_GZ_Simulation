<?xml version="1.0"?>
<!-- Same lab room as lab_table_coke.sdf: factory floor, walls, one Table only (no Coke, tools, second table, or ur2 props). -->
<!-- World plugins: gz-sim-sensors-system + ogre2 required for RGB/RGB-D camera rendering. -->
<!-- Keep <world name="lab_table_coke"> so /world/lab_table_coke/... topics match config/ur_gz_bridge.yaml. -->
<sdf version="1.10">
  <world name="lab_table_coke">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.5 0.5 0.52 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>1</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>4.0</mu>
                <mu2>4.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://factory_floor/meshes/floor_plane.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://factory_floor/materials/textures/floor.jpg</albedo_map>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="factory_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="wall_north">
          <pose>0 5.1 1.5 0 0 0</pose>
          <geometry>
            <box><size>12.4 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_north_vis">
          <pose>0 5.1 1.5 0 0 0</pose>
          <geometry>
            <box><size>12.4 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://factory_floor/materials/textures/wall.png</albedo_map>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_south">
          <pose>0 -5.1 1.5 0 0 0</pose>
          <geometry>
            <box><size>12.4 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_south_vis">
          <pose>0 -5.1 1.5 0 0 0</pose>
          <geometry>
            <box><size>12.4 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://factory_floor/materials/textures/wall.png</albedo_map>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_east">
          <pose>6.1 0 1.5 0 0 0</pose>
          <geometry>
            <box><size>0.2 10.4 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_east_vis">
          <pose>6.1 0 1.5 0 0 0</pose>
          <geometry>
            <box><size>0.2 10.4 3</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://factory_floor/materials/textures/wall.png</albedo_map>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_west">
          <pose>-6.1 0 1.5 0 0 0</pose>
          <geometry>
            <box><size>0.2 10.4 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_west_vis">
          <pose>-6.1 0 1.5 0 0 0</pose>
          <geometry>
            <box><size>0.2 10.4 3</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://factory_floor/materials/textures/wall.png</albedo_map>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://Table</uri>
      <name>lab_table</name>
      <pose>1 -0.55 0 0 0 0</pose>
    </include>

    <!-- Static black riser: full tabletop footprint (Table top_plate 2.2 x 0.9 m in world XY ≈ Y x X).
         Center (0.2, 0.55); tabletop z ≈ 0.98 m, h=0.20 m → center z=1.08, top z=1.18. -->
    <model name="grasp_cube_platform">
      <static>true</static>
      <pose>0.2 0.55 1.08 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.9 0.5 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.9 0.5 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic cubes on black platform (original layout: x=0.4, y row 0.55/0.45/0.35; z = 1.21). -->
    <model name="grasp_cube_red">
      <static>false</static>
      <pose>0.4 0.55 1.21 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.27</mass>
          <inertia>
            <ixx>1.62e-4</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.62e-4</iyy>
            <iyz>0</iyz>
            <izz>1.62e-4</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.9 0.15 0.12 1</diffuse>
            <specular>0.3 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue cube beside red (offset −Y on tabletop; centers spaced 0.1 m). -->
    <model name="grasp_cube_blue">
      <static>false</static>
      <pose>0.4 0.45 1.21 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.27</mass>
          <inertia>
            <ixx>1.62e-4</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.62e-4</iyy>
            <iyz>0</iyz>
            <izz>1.62e-4</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.25 0.85 1</ambient>
            <diffuse>0.15 0.35 0.95 1</diffuse>
            <specular>0.25 0.25 0.35 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow cube beside blue (offset −Y on tabletop). -->
    <model name="grasp_cube_yellow">
      <static>false</static>
      <pose>0.4 0.35 1.21 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.27</mass>
          <inertia>
            <ixx>1.62e-4</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.62e-4</iyy>
            <iyz>0</iyz>
            <izz>1.62e-4</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.82 0.1 1</ambient>
            <diffuse>0.95 0.88 0.15 1</diffuse>
            <specular>0.35 0.35 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
