<?xml version="1.0"?>

<sdf version="1.6">
  <!-- Red grasp cube: 4.5 cm side (fits Robotiq 2F-85). Link origin at bottom center of box. -->
  <model name="GraspCube">
    <static>false</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.045 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.08 0.10 1</ambient>
          <diffuse>0.90 0.14 0.16 1</diffuse>
          <specular>0.35 0.22 0.22 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.045 0.045</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <pose>0 0 0.0225 0 0 0</pose>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.000041</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000041</iyy>
          <iyz>0</iyz>
          <izz>0.000041</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
