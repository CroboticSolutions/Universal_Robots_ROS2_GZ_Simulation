<?xml version="1.0"?>

<sdf version="1.6">
  <model name='Coke'>
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

        <!-- Same scale on visual + collision. Tune s (uniform xyz). -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://Coke/meshes/coke.obj</uri>
              <scale>0.92 0.92 0.92</scale>
            </mesh>
          </geometry>
        </visual>

        <!-- Box primitive: ~ former cylinder bounds (0.066 ≈ 2×0.033), height 0.115. -->
        <collision name="collision">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry>
            <box>
              <size>0.055 0.055 0.14</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>7</mu>
                <mu2>7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- Inertia for uniform box m=0.345, size 0.066×0.066×0.115 (Z up). -->
        <inertial>
          <pose>0 0 0.0575 0 0 0</pose>
          <mass>0.345</mass>
          <inertia>
            <ixx>0.000505</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000505</iyy>
            <iyz>0</iyz>
            <izz>0.000250</izz>
          </inertia>
        </inertial>
    </link>
  </model>
</sdf>
