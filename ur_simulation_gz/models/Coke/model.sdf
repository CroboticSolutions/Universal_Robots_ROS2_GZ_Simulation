<?xml version="1.0"?>

<sdf version="1.6">
  <model name='Coke'>
    <static>false</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

        <!-- Mesh visual; scale uniforms < 1 shrink toward ~real can size vs raw OBJ. -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://Coke/meshes/coke.obj</uri>
              <scale>0.92 0.92 0.92</scale>
            </mesh>
          </geometry>
        </visual>

        <!-- Cylinder: h=0.14 m (ex-box); Ø=0.05 m → r=0.025 m. Axis +Z; bottom at link z=0. -->
        <collision name="collision">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.14</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>7</mu>
                <mu2>7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- Inertia: solid cylinder m=0.345, r=0.025, h=0.14 (Z up). -->
        <inertial>
          <pose>0 0 0.07 0 0 0</pose>
          <mass>0.345</mass>
          <inertia>
            <ixx>0.000617</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000617</iyy>
            <iyz>0</iyz>
            <izz>0.000108</izz>
          </inertia>
        </inertial>
    </link>
  </model>
</sdf>
