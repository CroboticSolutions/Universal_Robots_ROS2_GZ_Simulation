<?xml version="1.0"?>
<!-- Assets-only model: world embeds mesh/visual; this satisfies model://factory_floor resolution. -->
<sdf version="1.10">
  <model name="factory_floor">
    <static>true</static>
    <link name="assets">
      <pose>0 0 -500 0 0 0</pose>
      <collision name="noop">
        <geometry>
          <box><size>0.001 0.001 0.001</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
