<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="gear_part">
    <static>false</static>
    <link name="link">
      <inertial>
        <pose>0 0 0.005875 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00019820251</ixx>
          <ixy>0</ixy>
