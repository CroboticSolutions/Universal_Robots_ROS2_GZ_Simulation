<?xml version="1.0"?>
<sdf version="1.10">
  <model name="Table">
    <static>true</static>
    <!-- Visual: CAD mesh. Collision: single tabletop box only. -->
    <link name="tabletop">
      <!-- Mesh scale 0.001 (2× former 0.0005): link origin lifted so base matches doubled mesh. -->
      <pose>0 0 0.05 0 0 0</pose>

      <visual name="cad_mesh">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://Table/meshes/stainless_steel_table.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.45 1</ambient>
          <diffuse>0.55 0.56 0.58 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- Tabletop collision: 2× linear dims vs 0.0005 scale (matches 0.001 mesh scale). -->
      <collision name="top_plate">
        <pose>-0.8 1.1 0.88 0 0 -1.5708</pose>
        <geometry>
          <box>
            <size>2.2 0.9 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
