<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <!-- SRDF for UR + Robotiq gripper: extends ur_macro with gripper disable_collisions -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="tf_prefix" default=""/>

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- Gripper links: disable collisions with arm and between gripper links -->
  <disable_collisions link1="$(arg tf_prefix)tool0" link2="$(arg tf_prefix)ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)ur_to_robotiq_link" link2="$(arg tf_prefix)gripper_mount_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)gripper_mount_link" link2="$(arg tf_prefix)robotiq_85_base_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_base_link" link2="$(arg tf_prefix)ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)tool0" link2="$(arg tf_prefix)robotiq_85_base_link" reason="Default" />
  <disable_collisions link1="$(arg tf_prefix)wrist_3_link" link2="$(arg tf_prefix)ur_to_robotiq_link" reason="Default" />
  <disable_collisions link1="$(arg tf_prefix)wrist_3_link" link2="$(arg tf_prefix)robotiq_85_base_link" reason="Default" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_base_link" link2="$(arg tf_prefix)robotiq_85_left_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_base_link" link2="$(arg tf_prefix)robotiq_85_right_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_base_link" link2="$(arg tf_prefix)robotiq_85_left_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_base_link" link2="$(arg tf_prefix)robotiq_85_right_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_knuckle_link" link2="$(arg tf_prefix)robotiq_85_left_finger_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_right_knuckle_link" link2="$(arg tf_prefix)robotiq_85_right_finger_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_finger_link" link2="$(arg tf_prefix)robotiq_85_left_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_right_finger_link" link2="$(arg tf_prefix)robotiq_85_right_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_finger_tip_link" link2="$(arg tf_prefix)robotiq_85_left_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_right_finger_tip_link" link2="$(arg tf_prefix)robotiq_85_right_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_knuckle_link" link2="$(arg tf_prefix)robotiq_85_right_knuckle_link" reason="Default" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_finger_link" link2="$(arg tf_prefix)robotiq_85_right_finger_link" reason="Default" />
  <disable_collisions link1="$(arg tf_prefix)robotiq_85_left_finger_tip_link" link2="$(arg tf_prefix)robotiq_85_right_finger_tip_link" reason="Default" />
</robot>
