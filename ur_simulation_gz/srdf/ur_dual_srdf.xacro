<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <!-- SRDF for dual-arm: supports tf_prefix for link/joint names -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="tf_prefix" default=""/>

  <group name="ur_manipulator">
    <chain base_link="$(arg tf_prefix)base_link" tip_link="$(arg tf_prefix)tool0" />
  </group>
  <group_state name="home" group="ur_manipulator">
    <joint name="$(arg tf_prefix)elbow_joint" value="0" />
    <joint name="$(arg tf_prefix)shoulder_lift_joint" value="-1.5707" />
    <joint name="$(arg tf_prefix)shoulder_pan_joint" value="0" />
    <joint name="$(arg tf_prefix)wrist_1_joint" value="0" />
    <joint name="$(arg tf_prefix)wrist_2_joint" value="0" />
    <joint name="$(arg tf_prefix)wrist_3_joint" value="0" />
  </group_state>
  <group_state name="up" group="ur_manipulator">
    <joint name="$(arg tf_prefix)elbow_joint" value="0" />
    <joint name="$(arg tf_prefix)shoulder_lift_joint" value="-1.5707" />
    <joint name="$(arg tf_prefix)shoulder_pan_joint" value="0" />
    <joint name="$(arg tf_prefix)wrist_1_joint" value="-1.5707" />
    <joint name="$(arg tf_prefix)wrist_2_joint" value="0" />
    <joint name="$(arg tf_prefix)wrist_3_joint" value="0" />
  </group_state>
  <group_state name="test_configuration" group="ur_manipulator">
    <joint name="$(arg tf_prefix)elbow_joint" value="1.4" />
    <joint name="$(arg tf_prefix)shoulder_lift_joint" value="-1.62" />
    <joint name="$(arg tf_prefix)shoulder_pan_joint" value="1.54" />
    <joint name="$(arg tf_prefix)wrist_1_joint" value="-1.2" />
    <joint name="$(arg tf_prefix)wrist_2_joint" value="-1.6" />
    <joint name="$(arg tf_prefix)wrist_3_joint" value="-0.11" />
  </group_state>
  <disable_collisions link1="$(arg tf_prefix)base_link" link2="$(arg tf_prefix)base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)base_link_inertia" link2="$(arg tf_prefix)shoulder_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)tool0" link2="$(arg tf_prefix)wrist_1_link" reason="Never" />
  <disable_collisions link1="$(arg tf_prefix)tool0" link2="$(arg tf_prefix)wrist_2_link" reason="Never" />
  <disable_collisions link1="$(arg tf_prefix)tool0" link2="$(arg tf_prefix)wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)forearm_link" link2="$(arg tf_prefix)upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)forearm_link" link2="$(arg tf_prefix)wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)shoulder_link" link2="$(arg tf_prefix)upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)wrist_1_link" link2="$(arg tf_prefix)wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="$(arg tf_prefix)wrist_1_link" link2="$(arg tf_prefix)wrist_3_link" reason="Never" />
  <disable_collisions link1="$(arg tf_prefix)wrist_2_link" link2="$(arg tf_prefix)wrist_3_link" reason="Adjacent" />
</robot>
